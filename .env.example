# Copie para .env e ajuste. Valores abaixo servem apenas para desenvolvimento local.

# Postgres (superusuário do cluster, usado só pelo script de init)
POSTGRES_USER=katoshop
POSTGRES_PASSWORD=katoshop_dev

# Usuários de banco por serviço (criados por infra/postgres-init/01-databases.sh)
IDENTITY_DB_PASSWORD=identity_dev
CATALOG_DB_PASSWORD=catalog_dev
PROMOTIONS_DB_PASSWORD=promotions_dev

# Admin inicial criado pelo identity na subida (conta de demonstração)
IDENTITY_BOOTSTRAP_ADMIN_EMAIL=admin@katoshop.localhost
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=katoshop-demo-2026

# Gateway: porta HTTP no host (troque se a 80 estiver ocupada)
KATOSHOP_HTTP_PORT=80

# Grafana (acesso anônimo é só leitura; esta senha é do usuário admin)
GRAFANA_ADMIN_PASSWORD=katoshop_dev

# RabbitMQ (usuário da UI em 127.0.0.1:15672 e das conexões AMQP dos serviços)
RABBITMQ_USER=katoshop
RABBITMQ_PASSWORD=katoshop_dev
CATALOG_AMQP_URL=amqp://katoshop:katoshop_dev@rabbitmq:5672/
CART_AMQP_URL=amqp://katoshop:katoshop_dev@rabbitmq:5672/

# Cart: Redis e serviços que ele chama pela rede interna do compose
CART_REDIS_URL=redis://redis:6379/0
CART_CATALOG_URL=http://catalog:8000
CART_PROMOTIONS_URL=http://promotions:8000
CART_IDENTITY_TOKEN_URL=http://identity:8000/v1/auth/service-token

# Loja (BFF): o cart pela rede interna, sem passar pelo gateway (S13)
CART_API_URL=http://cart:8000

# Token de serviço (client credentials). O identity recusa segredo com menos de 32 caracteres.
# O segredo do cart aparece nas duas variáveis, com o mesmo valor. Fora do desenvolvimento,
# gere um segredo novo com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
IDENTITY_SERVICE_CLIENTS='{"cart":"cart-dev-secret-troque-fora-do-dev-0123456789"}'
CART_CLIENT_SECRET=cart-dev-secret-troque-fora-do-dev-0123456789

LOG_LEVEL=INFO

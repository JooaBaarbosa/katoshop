# Copie para .env e ajuste. Valores abaixo servem apenas para desenvolvimento local.

# Postgres (superusuário do cluster, usado só pelo script de init)
POSTGRES_USER=katoshop
POSTGRES_PASSWORD=katoshop_dev

# Usuários de banco por serviço (criados por infra/postgres-init/01-databases.sh)
IDENTITY_DB_PASSWORD=identity_dev
CATALOG_DB_PASSWORD=catalog_dev

# Admin inicial criado pelo identity na subida (conta de demonstração)
IDENTITY_BOOTSTRAP_ADMIN_EMAIL=admin@katoshop.localhost
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=katoshop-demo-2026

# Gateway: porta HTTP no host (troque se a 80 estiver ocupada)
KATOSHOP_HTTP_PORT=80

# Grafana (acesso anônimo é só leitura; esta senha é do usuário admin)
GRAFANA_ADMIN_PASSWORD=katoshop_dev

LOG_LEVEL=INFO

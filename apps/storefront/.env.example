# Copie para .env.local para rodar com `pnpm --filter @katoshop/storefront dev`.
# Gateway (Traefik). Os prefixos /identity e /catalog são acrescentados pela app.
API_URL=http://api.katoshop.localhost
# true somente atrás de HTTPS; em http local o navegador descarta cookies Secure.
COOKIE_SECURE=false
# Collector OTLP/HTTP. No compose o serviço usa http://otel-collector:4318 (perfil observability);
# fora do compose deixe vazio. Sem collector a app sobe normalmente.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Endereço público da loja (sitemap, robots, Open Graph). Padrão: http://katoshop.localhost
# SITE_URL=http://katoshop.localhost

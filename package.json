{
  "name": "katoshop",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:up": "uv run python scripts/gen_keys.py && docker compose up -d --build",
    "dev:down": "docker compose --profile \"*\" down",
    "seed": "docker compose --profile seed run --rm seed",
    "gen:api": "uv run python scripts/export_openapi.py && pnpm --filter @katoshop/api-client gen",
    "test:e2e": "echo \"pendente\"",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}

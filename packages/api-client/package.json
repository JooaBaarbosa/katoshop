{
  "name": "@katoshop/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./session": "./src/session.ts"
  },
  "scripts": {
    "gen": "openapi-typescript openapi/identity.json -o src/generated/identity.ts && openapi-typescript openapi/catalog.json -o src/generated/catalog.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.4.3",
    "openapi-fetch": "0.17.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@katoshop/config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
